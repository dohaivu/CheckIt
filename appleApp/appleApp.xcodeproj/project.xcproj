{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": { "anchor": "Configuration", "relative-path": "Config.xcconfig" } },
    { "name": "Release", "file": { "anchor": "Configuration", "relative-path": "Config.xcconfig" } },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/firebase/firebase-ios-sdk",
      "version": {
        "up-to-next-major-version": "13.1.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/google/GoogleSignIn-iOS",
      "version": {
        "up-to-next-major-version": "10.1.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sindresorhus/KeyboardShortcuts",
      "version": {
        "up-to-next-major-version": "3.1.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sergius-la/SwiftEmojiPicker",
      "version": {
        "up-to-next-major-version": "2.2.1",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "Configuration" },
    {
      "kind": "folder",
      "path": "iosApp",
      "target-membership": [
        "iosApp",
      ],
      "membership-exceptions": [
        {
          "target": "iosApp",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "macosApp",
      "target-membership": [
        "macosApp",
      ],
      "membership-exceptions": [
        {
          "target": "macosApp",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/CheckIt.app", "id": "7148A15A2F5FCF6000A64A50", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/CheckIt.app", "id": "71EAA46B3052D84100B51246", "type": "wrapper.application", "index": false },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<DEVELOPER>/Platforms/MacOSX.platform/Developer/SDKs/MacOSX26.2.sdk/System/Library/Frameworks/SwiftUI.framework" },
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework" },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework" },
      ],
    },
  ],
  "targets": [
    {
      "name": "iosApp",
      "id": "38834493044252A2C4BFAD03",
      "product": "id:7148A15A2F5FCF6000A64A50",
      "product-type": "application",
      "build-phases": [
        {
          "kind": "script",
          "name": "Compile Kotlin Framework",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [ \"YES\" = \"$OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED\" ]; then",
            "  echo \"Skipping Gradle build task invocation due to OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED environment variable set to \\\"YES\\\"\"",
            "  exit 0",
            "fi",
            "cd \"$SRCROOT/..\"",
            "./gradlew :shared:embedAndSignAppleFrameworkForXcode",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "iosApp/iosApp.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_ASSET_PATHS": "\"iosApp/Preview Content\"",
        "DEVELOPMENT_TEAM": "CGP4V9RVVW",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "iosApp/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "CheckIt",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.education",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.6",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.aimpact.app.checkit",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "macosApp",
      "id": "71EAA46A3052D84100B51246",
      "product": "id:71EAA46B3052D84100B51246",
      "product-type": "application",
      "build-phases": [
        {
          "kind": "script",
          "name": "Compile Kotlin Framework",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [ \"YES\" = \"$OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED\" ]; then",
            "  echo \"Skipping Gradle build task invocation due to OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED environment variable set to \\\"YES\\\"\"",
            "  exit 0",
            "fi",
            "cd \"$SRCROOT/..\"",
            "./gradlew :shared:embedAndSignAppleFrameworkForXcode",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "GoogleSignIn-iOS",
          "product-name": "GoogleSignIn",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "GoogleSignIn-iOS",
          "product-name": "GoogleSignInSwift",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KeyboardShortcuts",
          "product-name": "KeyboardShortcuts",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "SwiftEmojiPicker",
          "product-name": "SwiftEmojiPicker",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "SwiftEmojiPicker",
          "product-name": "SwiftEmojiPickerJSON",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAuth",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseFirestore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseStorage",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "macosApp/macosApp.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "2",
        "DEVELOPMENT_TEAM": "CGP4V9RVVW",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_FILE_ACCESS_DOWNLOADS_FOLDER": "readwrite",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "macosApp/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "CheckIt",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.2",
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.aimpact.app.checkit",
        "PRODUCT_NAME": "CheckIt",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "macosx",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
